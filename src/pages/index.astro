---
// The home page: Yo (tap it) and where to get the app beside a phone with the app on it, the outlets that covered
// Yo, how Yo works (the hero's phone travels down to the steps as you scroll), Security, the questions, and the store
// buttons once more at the end with the press kit.
import AsSeenOn from '../components/AsSeenOn.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import HowYoWorks from '../components/HowYoWorks.astro';
import PressKit from '../components/PressKit.astro';
import Security from '../components/Security.astro';
import YoPhilosophy from '../components/YoPhilosophy.astro';
import StoreButtons from '../components/StoreButtons.astro';
import YoPhone from '../mockups/yo-phone/YoPhone.astro';

const description = "Yo is back: the app that only sends Yo. One tap, end-to-end encrypted, no phone number. Open source.";
// For search engines: the site, and Yo as an iPhone app (free; the beta is on TestFlight).
const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': 'https://justyo.co/#website', name: 'Yo', url: 'https://justyo.co/', description },
    {
      '@type': 'MobileApplication',
      '@id': 'https://justyo.co/#app',
      name: 'Yo',
      url: 'https://justyo.co/',
      description,
      image: 'https://justyo.co/icon-512.png',
      operatingSystem: 'iOS',
      applicationCategory: 'SocialNetworkingApplication',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      author: { '@type': 'Person', name: 'Or Arbel' },
    },
  ],
});
---
<!doctype html>
<html lang="en">
  <head>
    <Head title="Yo – It's that simple." description={description} path="/" />
    <script type="application/ld+json" set:html={ld} />
    <style>
      html, body {
        margin: 0;
        background: #9B59B6;
        color: #fff;
        font-family: 'Montserrat', sans-serif;
        -webkit-tap-highlight-color: transparent;
      }
      body { min-height: 100vh; min-height: 100svh; display: flex; flex-direction: column; overflow-x: hidden; overflow-x: clip; }
      main { flex: 1; position: relative; }
      a { color: #fff; }

      /* Hero: one unit (the Yo, its line, the button) beside the phone; one above the other on a phone */
      .hero {
        max-width: 1000px;
        margin: 0 auto;
        box-sizing: border-box;
        padding: 112px 20px 24px;
        display: grid;
        grid-template-columns: 1fr;
        gap: 56px;
        align-items: center;
        justify-items: center;
        text-align: center;
      }
      .pitch { display: flex; flex-direction: column; align-items: center; }
      .pitch h1 { margin: 0; display: flex; flex-direction: column; align-items: inherit; }
      #yo {
        all: unset;
        cursor: pointer;
        font: 900 clamp(7rem, 34vw, 12.5rem)/0.82 'Montserrat', sans-serif;
        letter-spacing: -0.03em;
        user-select: none;
        -webkit-user-select: none;
        touch-action: manipulation;
      }
      #yo:focus-visible { outline: 2px solid #F1C40F; outline-offset: 6px; border-radius: 12px; }
      #yo.yo { animation: yo 0.35s ease-out; }
      @keyframes yo {
        0% { transform: scale(1); }
        40% { transform: scale(1.12) rotate(-4deg); }
        100% { transform: scale(1); }
      }
      .tag { margin-top: 18px; font: 600 clamp(1.3rem, 4.6vw, 1.7rem)/1.2 'Montserrat', sans-serif; letter-spacing: -0.005em; }
      .pitch :global(.stores) { margin-top: 36px; justify-content: center; }

      .tag em { font-style: normal; color: #F1C40F; }
      .device { display: flex; justify-content: center; --w: 280px; }

      /* The end: get Yo */
      .cta {
        max-width: 1000px;
        margin: 0 auto;
        box-sizing: border-box;
        padding: 112px 20px 72px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 20px 40px;
      }
      .cta h2 { margin: 0; font: 900 clamp(2.2rem, 7vw, 3.6rem)/1.05 'Montserrat', sans-serif; letter-spacing: -0.01em; }
      .cta :global(.stores) { justify-content: center; }

      @media (max-width: 360px) { .device { --w: 250px; } }
      @media (min-width: 900px) {
        /* the hero and the news band under it fill the first screen together */
        .hero { padding: 72px 20px 8px; text-align: left;
          min-height: calc(100vh - 260px); min-height: calc(100svh - 260px); align-content: center; }
        /* one unit: the words and the phone side by side in the middle, on one soft light, the Yo sized to the phone */
        .hero { grid-template-columns: auto auto; justify-content: center; gap: clamp(56px, 7vw, 104px); position: relative; isolation: isolate; }
        .hero::before {
          content: ""; position: absolute; z-index: -1; left: 50%; top: 50%; width: min(1100px, 100vw); height: 760px;
          transform: translate(-50%, -50%); pointer-events: none;
          background: radial-gradient(closest-side, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.05) 55%, transparent);
        }
        .pitch { align-items: flex-start; }
        /* the Y's own side bearing (margin-left), so its stroke lines up with the text below */
        #yo { font-size: clamp(12.5rem, 17vw, 17rem); margin-left: 0.03em; }
        .tag { font-size: clamp(1.7rem, 2.3vw, 2.15rem); margin-top: 22px; }
        .pitch :global(.stores) { justify-content: flex-start; }
        .device { --w: 300px; }
      }
      @media (prefers-reduced-motion: reduce) { #yo.yo { animation: none; } }
      /* The journey: one phone from the hero into How Yo works. With motion and JavaScript the hero's phone lives in a
         layer over the page and is placed, as you scroll, between its slot in the hero (tilted, larger) and the slot
         beside the steps (upright, the steps' size); in the page's own coordinates, so it scrolls natively and only
         the blend between the two slots is set per frame (transform only). Before the hero's slot leaves and after
         the steps' slot is reached it simply sits in one of them. Both slots keep their size. */
      /* z-index 0, last in main: over the page's sections, under the header (z-index 1) */
      .journey-layer { position: absolute; left: 0; top: 0; width: 0; height: 0; z-index: 0; }
      .journey-layer .traveller { position: absolute; left: 0; top: 0; transform-origin: 50% 50%; will-change: transform; backface-visibility: hidden; }
      :global(.journey-on) .traveller :global(.yo-phone.tilt) { transform: translateZ(0); }
      .spin { will-change: transform; }
    </style>
  </head>
  <body>
    <Header current="/" />
    <main>
      <section class="hero">
        <div class="pitch">
          <h1><button id="yo" aria-label="Yo">Yo</button><span class="tag">It's that simple. <em>Again.</em></span></h1>
          <StoreButtons />
        </div>
        <div class="device">
          <div class="traveller"><div class="spin"><YoPhone tilt={-3} autoplay screens={['list', 'signup', 'locked', 'code']} /></div></div>
        </div>
      </section>

      <AsSeenOn />

      <HowYoWorks />

      <YoPhilosophy />

      <Security />

      <Faq />
      <section class="cta" aria-labelledby="cta-title">
        <h2 id="cta-title">Just Yo.</h2>
        <StoreButtons><PressKit part="button" /></StoreButtons>
      </section>
      <PressKit part="panel" />
    </main>
    <Footer />
    <script>
      import { playYo } from '../lib/yo-sound';
      import { getYoPhone } from '../mockups/yo-phone/yo-phone';

      // The journey (see the CSS).
      const main = document.querySelector('main')!;
      const traveller = document.querySelector<HTMLElement>('.hero .traveller');
      const heroSlot = document.querySelector<HTMLElement>('.hero .device');
      const howSlot = document.querySelector<HTMLElement>('.how .tiltbox');
      if (traveller && heroSlot && howSlot && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const phone = traveller.querySelector<HTMLElement>('[data-yo-phone]')!;
        const howPhone = howSlot.querySelector<HTMLElement>('[data-yo-phone]')!;
        const slot = document.createElement('div');
        slot.setAttribute('aria-hidden', 'true');
        heroSlot.append(slot);
        const layer = document.createElement('div');
        layer.className = 'journey-layer';
        // the scoped styles of this page reach the layer through its attribute
        for (const a of traveller.getAttributeNames()) if (a.startsWith('data-astro-cid')) layer.setAttribute(a, '');
        main.append(layer);
        layer.append(traveller);
        main.classList.add('journey-on');
        // How Yo works' own phone now only holds the place: hidden from screen readers and out of the keyboard's reach.
        howPhone.setAttribute('aria-hidden', 'true');
        howPhone.inert = true;

        let W = 0, H = 0;
        let from = { x: 0, y: 0 }, to = { x: 0, y: 0, k: 1 }, start = 0, end = 1;
        const inMain = (el: Element) => {
          const r = el.getBoundingClientRect();
          const m = main.getBoundingClientRect();
          return { x: r.left - m.left + r.width / 2, y: r.top - m.top + r.height / 2, w: r.width, h: r.height };
        };
        const measure = () => {
          traveller.style.setProperty('--w', getComputedStyle(heroSlot).getPropertyValue('--w'));
          W = phone.offsetWidth;
          H = phone.offsetHeight;
          slot.style.width = `${W}px`;
          slot.style.height = `${H}px`;
          const a = inMain(slot);
          const b = inMain(howPhone);
          from = { x: a.x, y: a.y };
          to = { x: b.x, y: b.y, k: b.w / W };
          const top = main.getBoundingClientRect().top + scrollY;
          // From when the hero's slot starts to leave until the steps' slot sits in the middle of the window.
          start = Math.max(0, top + a.y - innerHeight / 2);
          end = Math.max(start + 1, top + b.y - innerHeight / 2);
          place();
        };
        const lerp = (p: number, q: number, t: number) => p + (q - p) * t;
        let queued = false;
        const place = () => {
          queued = false;
          const t = Math.min(1, Math.max(0, (scrollY - start) / (end - start)));
          const e = t * t * (3 - 2 * t);
          const x = lerp(from.x, to.x, e);
          const y = lerp(from.y, to.y, e);
          traveller.style.transform =
            `translate3d(${x - W / 2}px, ${y - H / 2}px, 0) rotate(${lerp(-3, 0, e)}deg) scale(${lerp(1, to.k, e)})`;
          // Back up towards the hero the phone shows the friends list again; down at the steps, the step chosen there.
          const zone = t < 0.5 ? 'hero' : 'how';
          if (zone !== lastZone) {
            lastZone = zone;
            const screen = zone === 'hero' ? 'list' : document.querySelector<HTMLElement>('.how .steps li.on')?.dataset.screen ?? 'list';
            getYoPhone(phone)?.show(screen);
          }
        };
        let lastZone = 'hero';
        addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(place); } }, { passive: true });
        addEventListener('resize', measure);
        new ResizeObserver(measure).observe(main);
        document.fonts?.ready.then(measure);
        measure();
      }

      const yo = document.getElementById('yo')!;
      yo.addEventListener('click', () => {
        yo.classList.remove('yo');
        void yo.offsetWidth;
        yo.classList.add('yo');
        playYo();
        navigator.vibrate?.(60);
      });
    </script>
  </body>
</html>
