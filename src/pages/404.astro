---
// Every path the site has no page for lands here (GitHub Pages serves 404.html). justyo.co/NAME is a Yo invite:
// with Yo installed iOS and Android open the app for it (apple-app-site-association, assetlinks.json); where they
// do not (Safari on this site, a typed link) "Open in Yo" does, with the app's scheme; without Yo it leads on to
// TestFlight. The name is read in the browser only; nothing is sent anywhere.
//
// The invite is the app's share card (YourCode.swift, ContactCodeCard: 360 x 450 points, the name at 32, a white QR
// code of 216 with 42 around it and "Yo" in its centre, the link at most 40 and fitted to 300), drawn here in
// container units so it scales with the window. The QR code is always shown, for a phone across the room.
import Head from '../components/Head.astro';
import { stores } from '../data/stores';
---
<!doctype html>
<html lang="en">
  <head>
    <Head title="Yo" noindex weights="700" share image="/og/invite.png" imageAlt="Yo | Yo me on Yo." />
    <style>
      html, body { margin: 0; height: 100%; background: #9B59B6; color: #fff; font-family: 'Montserrat', sans-serif; font-weight: 700; }
      main {
        min-height: 100%; box-sizing: border-box; padding: 1rem; display: flex; align-items: center;
        justify-content: center;
      }
      .column {
        width: 100%; max-width: 600px; display: flex; flex-direction: column; align-items: center; gap: 1.25rem;
        text-align: center;
      }
      .column > div { display: contents; }
      h1 { margin: 0; width: 100%; text-align: center; font-size: clamp(1.5rem, 6vw, 2.5rem); line-height: 1.2; overflow-wrap: anywhere; }
      p { margin: 0; font-size: 1.05rem; line-height: 1.45; opacity: .9; }
      /* The card: 360 x 450 in the app; 1cqw is 3.6 of its points. The height left for it is the window less the
         padding, the gap and the button. */
      .card {
        container-type: inline-size; box-sizing: border-box; aspect-ratio: 360 / 450;
        width: min(100%, 480px, calc((100svh - 2rem - 1.25rem - 4rem) * 0.8));
        display: flex; flex-direction: column; align-items: center; justify-content: space-between;
        background: #9B59B6; overflow: hidden;
      }
      .card .who {
        box-sizing: border-box; width: 100%; padding: 6.667cqw 6.667cqw 0; font-size: 8.889cqw; line-height: 1.22;
        overflow-wrap: anywhere; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
      }
      .card .code { position: relative; width: 60cqw; height: 60cqw; padding: 11.667cqw; flex: none; }
      .card .code svg { display: block; width: 100%; height: 100%; }
      .card .code span {
        position: absolute; left: 50%; top: 50%; width: 12.222cqw; height: 12.222cqw; transform: translate(-50%, -50%);
        display: flex; align-items: center; justify-content: center; background: #9B59B6; font-size: 6.667cqw;
      }
      .card .link {
        width: 83.333cqw; height: 11.111cqw; margin: 2.222cqw 0 4.444cqw; display: flex; align-items: center;
        justify-content: center; white-space: nowrap; font-size: 11.111cqw; line-height: 1;
      }
      a.button {
        display: block; box-sizing: border-box; width: 100%; max-width: 20rem; padding: 1rem 2rem;
        border-radius: 999px; background: #fff; color: #000; text-decoration: none; font-size: 1.25rem;
      }
      a.plain { color: #fff; opacity: .85; }
      .soon { opacity: .7; font-size: .95rem; margin-top: -.5rem; }
      [hidden] { display: none !important; }
    </style>
  </head>
  <body data-iphone={stores.iphone}>
    <main>
      <div class="column">
        <div id="invite" hidden>
          <div class="card" role="img" id="card">
            <div class="who"><span id="name"></span> wants to Yo</div>
            <div class="code"><div id="qrcode"></div><span aria-hidden="true">Yo</span></div>
            <div class="link"><span id="link"></span></div>
          </div>
          <a class="button" id="open" href="#">Open in Yo</a>
          <p class="soon" id="android" hidden>Yo for Android is in beta: <a href={stores.android}>join here</a>, then open this link again.</p>
          <p class="soon" id="scan" hidden>Scan the code with your phone to open it in Yo.</p>
        </div>
        <div id="lost">
          <h1>Nothing here.</h1>
          <p><a class="plain" href="/">justyo.co</a></p>
        </div>
      </div>
    </main>
    <script>
      import qrcode from 'qrcode-generator';

      const TESTFLIGHT = document.body.dataset.iphone!;
      const $ = (id: string) => document.getElementById(id)!;

      // A username (spec 3.3): up to 16 characters of letters, digits, _ and emoji, in one path part. The least is the
      // hub's (new names from 3); names from before stay, so their invite links work.
      let part = '';
      try { part = decodeURIComponent(location.pathname.replace(/^\/+|\/+$/g, '')); } catch {}
      // Characters are counted as graphemes where the browser has Intl.Segmenter, else as code points.
      const count = 'Segmenter' in Intl ? [...new Intl.Segmenter().segment(part)].length : Array.from(part).length;
      // A digit may come first ("1abc"), but a name has a letter or emoji: "404" is no invite.
      if (count >= 1 && count <= 16 && /^[\p{L}\p{M}\p{N}_\p{Extended_Pictographic}\p{Emoji_Component}‍]+$/u.test(part)
          && /[\p{L}\p{Extended_Pictographic}]/u.test(part)) {
        // The link as the app writes it (Invite.link): https://justyo.co/NAME.
        const link = 'https://justyo.co/' + part;
        $('name').textContent = part;
        $('link').textContent = link;
        $('card').setAttribute('aria-label', `Contact QR code for ${part}. ${link}`);
        $('invite').hidden = false;
        $('lost').hidden = true;
        document.title = `${part} wants to Yo you`;

        // As in the app: error correction H (the "Yo" in the centre covers a part), white modules on amethyst, the
        // card's own padding as the quiet zone.
        const code = qrcode(0, 'H');
        code.addData(unescape(encodeURIComponent(link)));
        code.make();
        const n = code.getModuleCount();
        let path = '';
        for (let y = 0; y < n; y++) for (let x = 0; x < n; x++) if (code.isDark(y, x)) path += `M${x} ${y}h1v1h-1z`;
        $('qrcode').innerHTML =
          `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${n} ${n}" shape-rendering="crispEdges"><path fill="#fff" d="${path}"/></svg>`;

        // The link shrinks to its box (the app's minimumScaleFactor); the name wraps to two lines and shrinks past that.
        const fit = (el: HTMLElement, box: HTMLElement, wide: boolean) => {
          el.style.fontSize = '';
          box.style.fontSize = '';
          const fits = () => (wide ? el.scrollWidth <= box.clientWidth : box.scrollHeight <= box.clientHeight + 1);
          let scale = 1;
          while (!fits() && scale > 0.1) {
            scale *= 0.95;
            (wide ? el : box).style.fontSize = `${(wide ? 11.111 : 8.889) * scale}cqw`;
          }
        };
        const who = document.querySelector('.card .who') as HTMLElement;
        const layout = () => { fit($('link'), $('link').parentElement!, true); fit(who, who, false); };
        layout();
        document.fonts?.ready.then(layout);
        new ResizeObserver(layout).observe($('card'));

        const ua = navigator.userAgent;
        const android = /Android/i.test(ua);
        const iphone = /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
        const open = $('open') as HTMLAnchorElement;
        open.href = 'yo://' + encodeURIComponent(part);

        // Universal and App Links do not fire for a link opened inside Safari on its own site, typed or pasted; the
        // app's own scheme (yo://NAME: Info.plist CFBundleURLTypes, the Android intent filter) does. If the page is
        // still in front 1.5 s later, Yo is not installed: iPhone goes to TestFlight, Android to the beta group. A computer
        // has no Yo: it points at the QR code for the phone.
        open.addEventListener('click', (event) => {
          if (!iphone && !android) {
            event.preventDefault();
            $('scan').hidden = false;
            return;
          }
          let timer = 0;
          const cancel = () => { clearTimeout(timer); document.removeEventListener('visibilitychange', cancel); };
          timer = window.setTimeout(() => {
            cancel();
            if (document.hidden) return;
            if (iphone) location.href = TESTFLIGHT;
            else $('android').hidden = false;
          }, 1500);
          document.addEventListener('visibilitychange', () => { if (document.hidden) cancel(); });
          window.addEventListener('pagehide', cancel, { once: true });
        });
      }
    </script>
  </body>
</html>
