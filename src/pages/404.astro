---
// Every path the site has no page for lands here (GitHub Pages serves 404.html): an invite, justyo.co/NAME, or a service
// added since the site was built (services/[service].astro has the others).
import Head from '../components/Head.astro';
import Invite from '../components/Invite.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <Head title="Yo" noindex weights="700;900" share image="/og/invite.png" imageAlt="Yo | Yo me on Yo." />
  </head>
  <body>
    <script is:inline>
      // GitHub Pages knows /services, not /services/.
      var path = '/' + location.pathname.replace(/^\/+|\/+$/g, '');
      if (path !== '/' && path !== location.pathname) location.replace(path + location.search + location.hash);
    </script>
    <Invite />
  </body>
</html>
