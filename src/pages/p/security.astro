---
// How Yo protects your messages in plain words, what it does not do yet, and the technical details (in full: yo/spec/v1.md).
import Header from '../../components/Header.astro';

// Headings: the "Yo" of Yo, Yos, YoIP and Your in heavy type, the rest lighter.
const yo = (text: string) =>
  text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/(^|[^A-Za-z])Yo/g, '$1<b>Yo</b>');

const tiles = [
  {
    img: 'packages',
    alt: 'A row of cardboard boxes, each with a sleepy purple "Yo" in its window and a padlock',
    title: 'YoIP with Yo2Yo Encryption',
    text: "We can't read your Yos.",
    tech: ['Built on the <a href="https://signal.org/docs/">Signal Protocol</a>, the encryption Signal and WhatsApp use.', 'Ready for tomorrow: even future quantum computers won\'t crack it.', 'If a key ever leaks, your next Yos lock themselves up again.', '<a href="https://github.com/YoAgain/yo/blob/main/spec/v1.md">Read the full spec</a>.'],
  },
  {
    img: 'sealed',
    alt: 'A cream envelope closed with a purple wax seal stamped "Yo"',
    title: 'Sealed Yos.',
    text: '',
    tech: ["Between friends: sealed envelopes, no sender. We don't know who Yos whom.", "A first Yo to someone new is a request: it shows who asks, so we can stop spam.", "Every Yo looks the same size from outside.", "No phone number or address book needed."],
  },
  {
    img: 'photos',
    alt: 'An instant camera labelled "Yo", its photo showing only a padlock',
    title: 'Photos, encrypted.',
    text: '',
    tech: ["Every photo and video gets its own key.", "Fetched only a few times; gone once seen."],
  },
  {
    img: 'yours',
    alt: 'A key in a lock, the keyring tag reads "Yo"',
    title: 'Yo Backup.',
    text: '',
    tech: ["Recover your Yodentity with Face ID or your 12-word Restore Code.", "Your backup gets locked on your iPhone.", "We store it. We can't open it."],
  },
]
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#9B59B6" />
    <title>Yo – Security</title>
    <meta name="description" content="Nobody can read your Yos. How Yo protects your messages, in plain words and in detail." />
    <link rel="canonical" href="https://justyo.co/p/security" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yo" />
    <meta property="og:url" content="https://justyo.co/p/security" />
    <meta property="og:title" content="YoIP: nobody can read your Yos." />
    <meta property="og:description" content="End-to-end encrypted with the Signal Protocol. No phone number, no address book." />
    <meta property="og:image" content="https://justyo.co/og-image.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;700;900&display=swap" rel="stylesheet" />
    <link rel="preload" as="image" href="/img/security/packages.webp" type="image/webp" />
    <style>
      html, body {
        margin: 0;
        background: #9B59B6;
        color: #fff;
        -webkit-tap-highlight-color: transparent;
      }
      body {
        font: 17px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: radial-gradient(120% 60% at 50% 0%, #A96BC3 0%, #9B59B6 55%, #8E4BAA 100%) #9B59B6;
        background-attachment: fixed;
      }
      main {
        max-width: 1000px;
        margin: 0 auto;
        padding: 84px 16px 56px;
      }
      h1, h2, h3, summary { font-family: 'Montserrat', sans-serif; font-weight: 500; }
      h3, .tech > summary { font-weight: 900; }
      h1 b, h2 b, h3 b, summary b { font-weight: 900; }
      a { color: #fff; }
      p { margin: 0; }

      /* Soft 3D cards, like the renders: rounded, lit from above, resting on a soft shadow */
      .card {
        position: relative;
        overflow: hidden;
        border-radius: 26px;
        background: linear-gradient(165deg, #AE7BC8 0%, #9C5DB8 55%, #8B45A8 100%);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 18px 36px -18px rgba(55, 12, 85, 0.7);
      }
      .card img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; }
      .card .text { padding: 16px 18px 18px; }
      .big img { aspect-ratio: 16 / 9; }
      .big h2 { font-size: clamp(1.5rem, 4.6vw, 1.9rem); }
      .lead2 { font-size: 1.1rem; }
      .more summary { cursor: pointer; list-style: none; font: 400 1rem/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
      .more summary::-webkit-details-marker { display: none; }
      .more summary { display: flex; align-items: center; gap: 10px; }
      .more summary h2 { margin: 0; }
      .more summary i { display: inline-block; font: 900 1.4rem/1 'Montserrat', sans-serif; font-style: normal;
        color: #fff; opacity: 0.85; transition: transform 0.2s; }
      .more[open] summary i { transform: rotate(90deg); }
      :global(.card a) { color: #fff; }
      .more ul { margin: 10px 0 0; padding-left: 1.1em; font-size: 15px; }
      .more li { margin: 3px 0; }
      h2 {
        margin: 0 0 6px;
        font-size: clamp(1.2rem, 4vw, 1.35rem);
        line-height: 1.12;
        text-shadow: 0 2px 0 rgba(60, 10, 90, 0.25);
      }

      .sub { margin: -10px 0 22px; font-size: 1.15rem; opacity: 0.9; }
      h1#top { margin: 0 0 20px; font-size: clamp(2rem, 7vw, 3rem); font-weight: 900; }
      .next { margin-top: 8px; }
      h1 {
        margin: 0 0 14px;
        font-size: clamp(2.3rem, 9vw, 4rem);
        line-height: 1.02;
        text-shadow: 0 3px 0 rgba(60, 10, 90, 0.28);
      }
      .lead { font-size: clamp(1.05rem, 2.6vw, 1.2rem); }

      .grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
      }

      .tech {
        margin-top: 36px;
        border-radius: 26px;
        background: rgba(50, 10, 80, 0.2);
        box-shadow: inset 0 2px 6px rgba(40, 5, 70, 0.25), 0 1px 0 rgba(255, 255, 255, 0.2);
        font-size: 15.5px;
      }
      .tech > summary {
        cursor: pointer;
        list-style: none;
        padding: 20px 24px;
        font-size: clamp(1.2rem, 4vw, 1.45rem);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        border-radius: 26px;
      }
      summary::-webkit-details-marker { display: none; }
      .tech > summary::after {
        content: "+";
        flex: none;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        color: #8E44AD;
        background: linear-gradient(180deg, #FFE36E, #F1C40F);
        box-shadow: inset 0 -2px 0 rgba(150, 100, 0, 0.35), 0 4px 10px -4px rgba(40, 5, 70, 0.6);
        transition: transform 0.2s;
      }
      .tech[open] summary::after { transform: rotate(45deg); }
      summary:focus-visible { outline: 2px solid #F1C40F; outline-offset: 2px; }
      .intro { padding: 0 24px; font-size: 15.5px; }
      .groups {
        display: grid;
        grid-template-columns: 1fr;
        gap: 6px 32px;
        padding: 0 24px 22px;
      }
      h3 { margin: 14px 0 4px; font-size: 1rem; color: #F1C40F; }
      .groups ul { margin: 0; padding-left: 1.1em; }
      .groups li { margin: 5px 0; }
      .groups li::marker { color: rgba(255, 255, 255, 0.6); }

      .after { margin-top: 24px; font-size: 15.5px; }
      .after .muted { margin-left: 0.6em; }
      .muted { opacity: 0.75; font-size: 14px; }
      footer { margin-top: 36px; text-align: center; font-size: 14px; }
      footer a { opacity: 0.7; text-decoration: none; margin: 0 0.6rem; }
      footer a:hover { opacity: 1; }

      @media (min-width: 700px) {
        .grid { grid-template-columns: repeat(3, 1fr); gap: 16px; }
        .big { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); }
        .big img { height: 100%; }
        .big .text { padding: 22px 24px; align-self: center; }
      }
      @media (max-width: 420px) { body { font-size: 16px; } }
      @media (prefers-reduced-motion: reduce) { summary::after { transition: none; } }
    </style>
  </head>
  <body>
    <Header current="/p/security" />
    <main>
      <h1 id="top">Security</h1>
      <div class="grid">
        {tiles.map((t, i) => (
          <section class={i === 0 ? 'card big' : 'card'}>
            <img src={`/img/security/${t.img}.webp`} width="960" height="540" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" alt={t.alt} />
            <div class="text">
              {i === 0 ? (
                <>
                  <h2 set:html={yo(t.title)} />
                  <p class="lead2">YoIP (Yo over IP) implements the <a href="https://signal.org/docs/">Signal Protocol</a>, so nobody can
                    read your Yos. Not even us.</p>
                  <p class="next"><a href="https://github.com/YoAgain/yo/blob/main/spec/v1.md">Read the spec</a></p>
                </>
              ) : (
                <details class="more">
                  <summary><h2 set:html={yo(t.title)} /><i aria-hidden="true">›</i></summary>
                  <ul>{t.text && <li>{t.text}</li>}{t.tech.map((f) => <li set:html={f} />)}</ul>
                </details>
              )}
            </div>
          </section>
        ))}
      </div>

      <details class="tech">
        <summary set:html={yo("The technical details")} />
        <p class="intro">Everything below is specified in full in the
          <a href="https://github.com/YoAgain/yo/blob/main/spec/v1.md">Yo over IP spec</a>, next to the open source code.</p>
        <div class="groups">
          <div>
            <h3 set:html={yo("Encryption")} />
            <ul>
              <li>libsignal: PQXDH, Double Ratchet + SPQR</li>
              <li>Post-quantum, forward secret, self-healing</li>
            </ul>
          </div>
          <div>
            <h3 set:html={yo("Metadata")} />
            <ul>
              <li>Sealed sender: Signal's, with a sender certificate</li>
              <li>Server sees: inbox + size bucket</li>
              <li>Padding: 1 / 4 / 16 / 64 KiB</li>
              <li>Sealed only for contacts (access key), limited by address</li>
              <li>Anonymous requests: separate connections</li>
            </ul>
          </div>
          <div>
            <h3 set:html={yo("Identity & keys")} />
            <ul>
              <li>Account key certifies your devices</li>
              <li>Safety numbers, verified mark, key-change warning</li>
              <li>Key answers signed by the hub, pinned in the app</li>
              <li>No phone number, no address book</li>
            </ul>
          </div>
          <div>
            <h3 set:html={yo("On your iPhone")} />
            <ul>
              <li>Local state encrypted, key in the Keychain</li>
            </ul>
          </div>
          <div>
            <h3 set:html={yo("Photos & videos")} />
            <ul>
              <li>Own random key per photo / video</li>
              <li>Limited fetches, deleted after viewing</li>
            </ul>
          </div>
          <div>
            <h3 set:html={yo("Backup")} />
            <ul>
              <li>Encrypted on your iPhone: passkey or 12 words</li>
              <li>Server stores it, can't read it</li>
            </ul>
          </div>
          <div>
            <h3 set:html={yo("Server")} />
            <ul>
              <li>Signed requests, replay protection</li>
              <li>What it keeps: <a href="/p/privacy">privacy policy</a></li>
            </ul>
          </div>
          <div>
            <h3 set:html={yo("Code")} />
            <ul>
              <li>Open source: MIT, libsignal AGPL-3.0</li>
              <li>Fuzzing, stress tests, signed commits</li>
              <li><a href="https://github.com/YoAgain/yo">Source</a> · <a href="https://github.com/YoAgain/yo/blob/main/spec/v1.md">Spec</a></li>
            </ul>
          </div>
          <div>
            <h3 set:html={yo("Not there yet")} />
            <ul>
              <li>Key transparency (until then: compare safety numbers)</li>
              <li>TLS pinning, on purpose: keys are server-signed instead</li>
            </ul>
          </div>
        </div>
      </details>

      <p class="after">Found a security problem? Write to <a href="mailto:privacy@justyo.app">privacy@justyo.app</a>.
        <span class="muted">Last updated: November 15, 2026</span></p>

      <footer><a href="/">Yo</a><a href="/p/privacy">Privacy</a></footer>
    </main>
  </body>
</html>
