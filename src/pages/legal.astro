---
// One page for the legal texts: Imprint, Terms and Privacy stacked, each with an anchor. The old /p/imprint, /p/terms and
// /p/privacy (linked from the apps and store listings) redirect to the anchors here.
import Footer from '../components/Footer.astro';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Imprint from '../components/legal/Imprint.astro';
import Terms from '../components/legal/Terms.astro';
import Privacy from '../components/legal/Privacy.astro';
const description = 'Yo legal: imprint, terms of service and privacy policy.';
---
<!doctype html>
<html lang="en">
  <head>
    <Head title="Yo – Imprint, ToS & Privacy" description={description} path="/legal" image="/og/legal.png" imageAlt="Yo | Imprint, ToS & Privacy" />
    <style is:global>
      html, body { margin: 0; background: #9B59B6; color: #fff; scroll-behavior: smooth; }
      body { font: 16px/1.45 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
      main { max-width: 680px; margin: 0 auto; padding: 84px 20px 24px; min-height: 100vh; min-height: 100svh; box-sizing: border-box; display: flex; flex-direction: column; }
      h1, h2, h3 { font-family: 'Montserrat', sans-serif; }
      h1 { font-size: 36px; margin: 0 0 4px; }
      h2 { font-size: 30px; margin: 0 0 4px; }
      h3 { font-size: 14px; margin: 0 0 4px; }
      h3.sub { font-size: 20px; margin: 26px 0 8px; }
      p, li { margin: 6px 0; }
      ul { padding-left: 22px; }
      a { color: inherit; text-underline-offset: 3px; }
      .muted { opacity: .8; font-size: 14px; }
      address { font-style: normal; }
      .legal-nav { display: flex; flex-wrap: wrap; gap: 8px; margin: 14px 0 6px; }
      .legal-nav a { padding: 6px 14px; border-radius: 999px; background: rgba(255,255,255,.14); text-decoration: none; font-weight: 600; }
      .legal-section { margin-top: 44px; padding-top: 28px; border-top: 1px solid rgba(255,255,255,.25); scroll-margin-top: 70px; }
      .legal-section .note { margin-top: 14px; }
      .t { width: 100%; table-layout: fixed; border-collapse: separate; border-spacing: 0; background: rgba(255,255,255,.08); border-radius: 14px; font-size: 15px; line-height: 1.4; margin: 4px 0 6px; overflow: hidden; }
      .t td { padding: 10px 12px; text-align: left; vertical-align: middle; }
      .t tr + tr td { border-top: 1px solid rgba(255,255,255,.1); }
      .t .n { font-weight: 600; white-space: nowrap; }
      .t .d { font-size: 14px; opacity: .75; }
      .t .n { width: 30%; }
      .t .d span { white-space: nowrap; }
      .law { opacity: .7; }
      /* the small print under the main rows: smaller and quieter */
      .t.minor { margin-top: 10px; font-size: 13.5px; background: rgba(255,255,255,.05); }
      .t.minor td { padding: 7px 12px; }
      .t.minor .n { font-weight: 500; opacity: .9; }
      .t.minor .d { font-size: 13px; }
      .note { margin: 6px 0 0; font-size: 13px; opacity: .7; }
      @media (max-width: 600px) {
        .t, .t tbody { display: block; }
        .t tr { display: block; padding: 10px 14px; }
        .t tr + tr { border-top: 1px solid rgba(255,255,255,.1); }
        .t td, .t tr + tr td { border: 0; padding: 0; }
        .t td { display: block; }
        .t .n { white-space: normal; width: auto; }
        .t .d { margin-top: 2px; }
      }
      @media (max-width: 540px) {
        h1 { font-size: 30px; }
        h2 { font-size: 18px; }
      }
      @media (max-width: 540px) { h1 { font-size: 30px; } h2 { font-size: 26px; } h3.sub { font-size: 18px; } }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <h1><a href="/" style="text-decoration:none">Yo</a> – Legal</h1>
      <nav class="legal-nav" aria-label="On this page">
        <a href="#imprint">Imprint</a>
        <a href="#terms">Terms</a>
        <a href="#privacy">Privacy</a>
      </nav>

      <Imprint />
      <Terms />
      <Privacy />
      <Footer />
    </main>
  </body>
</html>
