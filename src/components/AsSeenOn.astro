---
// "In the news since 2014": the outlets that covered Yo as wordmarks, running past across the whole page in a darker
// strip between two hairlines, the label above them; each linked to its story. Pauses on hover and
// focus; with reduced motion it stands still and wraps.
import Wordmark from './Wordmark.astro';
import { outlets } from '../lib/outlets';
---
<section class="seen" aria-labelledby="seen-title">
  <div class="strip">
    <h2 id="seen-title"><a class="t" href="/p/story#press">In the news since 2014</a></h2>
    <div class="band">
      <div class="track">
        {[0, 1].map((copy) => (
          <ul aria-hidden={copy === 1 ? 'true' : undefined}>
            {outlets.map((o) => (
              <li>
                <a href={o.url} rel="noopener" target="_blank" title={o.title} tabindex={copy === 1 ? -1 : undefined}><Wordmark name={o.name} mark={o.mark} size={33} /></a>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </div>
</section>
<style>
  .seen { padding: 28px 0 8px; color: #fff; }
  .strip {
    display: flex; flex-direction: column; align-items: center; gap: 18px; padding: 22px 0 28px;
    background: rgba(50, 10, 80, 0.16);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.14), inset 0 -1px 0 rgba(255, 255, 255, 0.14);
  }
  h2 { flex: none; margin: 0; text-align: center; font: 800 14px/1.35 'Montserrat', sans-serif; letter-spacing: 0.16em; text-transform: uppercase; }
  .t { color: #F1C40F; text-decoration: none; }
  .t:hover { text-decoration: underline; text-underline-offset: 4px; }
  .t:focus-visible { outline: 2px solid #fff; outline-offset: 4px; border-radius: 4px; }
  .band {
    width: 100%; overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .track { display: flex; width: max-content; animation: run 100s linear infinite; }
  .band:hover .track, .band:focus-within .track { animation-play-state: paused; }
  ul { display: flex; align-items: center; margin: 0; padding: 0; list-style: none; }
  li { display: flex; align-items: center; margin: 0 38px; }
  a { display: block; color: #fff; text-decoration: none; opacity: 0.85; transition: opacity 0.15s; }
  a:hover, a:focus-visible { opacity: 1; }
  a:focus-visible { outline: 2px solid #F1C40F; outline-offset: 4px; border-radius: 4px; }
  @keyframes run { to { transform: translateX(-50%); } }
  @media (max-width: 600px) {
    .strip { gap: 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .band { -webkit-mask-image: none; mask-image: none; }
    .track { animation: none; width: auto; }
    .track ul { flex-wrap: wrap; row-gap: 10px; }
    .track ul[aria-hidden] { display: none; }
  }
</style>
