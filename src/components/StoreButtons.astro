---
// Where to get Yo: the iPhone beta on TestFlight (no App Store listing yet) and Google Play, which has no listing yet
// either, so its button is a quiet outline saying "Coming soon" and goes nowhere. Drawn here, no badge images. A slot
// takes one more button of the same size into the row (the press kit, at the end of the home page).
const testflight = 'https://testflight.apple.com/join/V3wa1DeX';
---
<div class="stores">
  <a class="store" href={testflight} target="_blank" rel="noopener" aria-label="Join the iPhone beta on TestFlight">
    <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="currentColor" d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/></svg>
    <span><small>iPhone beta on</small>TestFlight</span>
  </a>
  <span class="store soon" role="link" aria-disabled="true" aria-label="Google Play: coming soon">
    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z"/></svg>
    <span><small>Coming soon to</small>Google Play</span>
  </span>
  <slot />
</div>
<style>
  .stores { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; }
  .store {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    box-sizing: border-box;
    padding: 8px 18px 8px 14px;
    border-radius: 14px;
    background: linear-gradient(180deg, #2a2230 0%, #120d16 100%);
    color: #fff;
    text-decoration: none;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18), 0 14px 26px -14px rgba(40, 5, 70, 0.9);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .store svg { width: 22px; height: 22px; }
  .store span { display: flex; flex-direction: column; font: 700 1.05rem/1.1 'Montserrat', sans-serif; text-align: left; }
  .store small { font: 500 0.68rem/1.3 'Montserrat', sans-serif; opacity: 0.85; }
  a.store:hover { transform: translateY(-2px); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18), 0 18px 30px -14px rgba(40, 5, 70, 0.95); }
  a.store:focus-visible { outline: 2px solid #F1C40F; outline-offset: 3px; }
  /* Google Play has no listing yet: the same button, quieter (an outline on the purple) */
  .soon { background: rgba(30, 10, 45, 0.18); box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.4); cursor: default; }
  .soon svg { width: 20px; height: 20px; }
  .soon svg, .soon span { opacity: 0.75; }
  @media (prefers-reduced-motion: reduce) { .store { transition: none; } }
</style>
