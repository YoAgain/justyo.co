---
// The press kit: a button the size of the store buttons (part="button", in their row) and the kit itself (part="panel",
// under the row): name, slogans, type, the colours (Amethyst, Violet, Lilac and the rows' Flat UI palette, each code
// copied by a tap), and the logo, app icon and press images (public/press/; the images are rendered from today's app, 2026). The button opens and closes the panel; justyo.co/#press opens it, and an
// open kit puts #press in the address so a reload keeps it open.
interface Props { part: 'button' | 'panel' }
const { part } = Astro.props;
// the rows of the app, in the order of the 2015 press screens (as in the app's Brand.swift)
const rowColours = [['#1ABC9C', 'Turquoise'], ['#2ECC71', 'Emerald'], ['#3498DB', 'Peter River'], ['#34495E', 'Wet Asphalt'],
  ['#16A085', 'Green Sea'], ['#F1C40F', 'Sunflower'], ['#2980B9', 'Belize Hole'], ['#8E44AD', 'Wisteria']];
const rows = rowColours.map(([c]) => c);
const stripes = `linear-gradient(${rows.map((c, i) => `${c} ${(i * 100) / rows.length}% ${((i + 1) * 100) / rows.length}%`).join(', ')})`;
const colours = [
  { hex: '#9B59B6', name: 'Amethyst', note: 'Logo, site, press. The App Store icon in 2014.' },
  { hex: '#9A44BE', name: 'Violet', note: 'Current app icon & 2016–2021 / Yo on X.' },
  { hex: '#AD72C3', name: 'Lilac', note: 'The App Store icon, 2015–2021.' },
  { hex: '8 colours', name: 'Rows', note: 'One per friend in the app.', bg: stripes },
];
const files = [
  { href: '/press/Yo_Logo_RBG.jpg', thumb: '/press/thumbs/Yo_Logo_RBG.webp', title: 'Logo' },
  { href: '/press/yo-app-icon.png', thumb: '/press/yo-app-icon.png', title: 'App icon', icon: true },
  { href: '/press/yo-logo-phone.jpg', thumb: '/press/thumbs/yo-logo-phone.webp', title: 'Logo and phone' },
  { href: '/press/yo-three-screens.jpg', thumb: '/press/thumbs/yo-three-screens.webp', title: 'Three screens' },
  { href: '/press/yo-two-phones.jpg', thumb: '/press/thumbs/yo-two-phones.webp', title: 'Two phones' },
];
---
{part === 'button' ? (
  <a class="pk-btn" href="#press" aria-controls="press" aria-expanded="false">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M4 5h13v14H6a2 2 0 0 1-2-2zM17 9h3v8a2 2 0 0 1-2 2h-1M7 9h7M7 12.5h7M7 16h4"/></svg>
    <span><small>For the media</small>Press kit</span>
  </a>
) : (
  <section class="press" id="press" aria-label="Press kit">
  {/* The kit is in the page and shows without JavaScript; with it the kit is closed until opened (html.js). */}
  <div class="kit">
   <div class="col">
    <div class="facts">
      <div><h3>Name</h3><b>Yo</b><span class="s">Never YO, yo or Yo!</span></div>
      <div><h3>Slogans</h3><b>It’s that simple. <span class="or">or</span> Just Yo.</b></div>
      <div><h3>Type</h3><b>Montserrat Bold</b></div>
    </div>
   </div>
   <div class="col">
      <h3>Colours</h3>
      <ul class="colours">
        {colours.map((c) => (
          <li>
            {c.bg
              ? <button type="button" class="sw" aria-expanded="false" aria-controls="rows-codes"><i style={`background:${c.bg}`}></i><span><b>{c.name}</b> <code>{c.hex}</code><br /><span class="s">{c.note}</span></span></button>
              : <button type="button" class="sw" data-copy={c.hex}><i style={`background:${c.hex}`}></i><span><b>{c.name}</b> <code>{c.hex}</code><br /><span class="s">{c.note}</span></span></button>}
          </li>
        ))}
      </ul>
      <ul class="codes" id="rows-codes">
        {rowColours.map(([hex, name]) => (
          <li><button type="button" class="chip" data-copy={hex}><i style={`background:${hex}`}></i><span>{name}<code>{hex}</code></span></button></li>
        ))}
      </ul>
    </div>
   <div class="imgs">
    <h3>Logo &amp; images</h3>
    <ul class="dl">
      {files.map((f) => (
        <li><a href={f.href} target="_blank" rel="noopener"><span class={f.icon ? 'th icon' : 'th'}><img src={f.thumb} alt="" loading="lazy" /></span><span>{f.title}</span></a></li>
      ))}
    </ul>
   </div>
  </div>
  </section>
)}
<script>
  // The colours: a tap copies the code (and says so for a moment); the rows' entry opens their eight codes.
  document.querySelectorAll<HTMLButtonElement>('.colours .sw[aria-controls]').forEach((b) =>
    b.addEventListener('click', () => {
      const list = document.getElementById(b.getAttribute('aria-controls')!)!;
      const open = list.classList.toggle('open');
      b.setAttribute('aria-expanded', String(open));
    }),
  );
  document.querySelectorAll<HTMLButtonElement>('.press [data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      const code = b.querySelector('code')!;
      const hex = b.dataset.copy!;
      try { await navigator.clipboard.writeText(hex); } catch { return; }
      code.textContent = 'Copied';
      setTimeout(() => (code.textContent = hex), 1200);
    }),
  );

  // The button opens and closes the kit; #press in the address keeps it open across a reload.
  const panel = document.getElementById('press') as HTMLElement | null;
  const buttons = [...document.querySelectorAll<HTMLAnchorElement>('.pk-btn')];
  const set = (open: boolean, scroll = false) => {
    if (!panel) return;
    panel.classList.toggle('open', open);
    buttons.forEach((b) => b.setAttribute('aria-expanded', String(open)));
    const want = open ? '#press' : '';
    if (location.hash !== want) history.replaceState(null, '', location.pathname + location.search + want);
    if (open && scroll) panel.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
  };
  buttons.forEach((b) => b.addEventListener('click', (e) => { e.preventDefault(); set(!panel?.classList.contains('open'), true); }));
  if (location.hash === '#press') set(true, true);
  addEventListener('hashchange', () => { if (location.hash === '#press') set(true, true); });
</script>
<style>
  .pk-btn {
    display: inline-flex; align-items: center; gap: 9px; box-sizing: border-box; padding: 8px 18px 8px 14px; border-radius: 14px;
    color: #fff; text-decoration: none; background: rgba(255, 255, 255, 0.14);
    box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.45); transition: transform 0.15s, background 0.15s;
  }
  .pk-btn:hover { transform: translateY(-2px); background: rgba(255, 255, 255, 0.2); }
  .pk-btn[aria-expanded='true'] { background: rgba(255, 255, 255, 0.24); }
  .pk-btn:focus-visible { outline: 2px solid #F1C40F; outline-offset: 3px; }
  .pk-btn span { display: flex; flex-direction: column; font: 700 1.05rem/1.1 'Montserrat', sans-serif; text-align: left; }
  .pk-btn small { font: 500 0.68rem/1.3 'Montserrat', sans-serif; opacity: 0.85; }
  .press {
    max-width: 960px; width: calc(100% - 40px); margin: 0 auto 8px; box-sizing: border-box; border-radius: 26px; color: #fff;
    padding-top: 24px; background: rgba(50, 10, 80, 0.2);
    box-shadow: inset 0 2px 6px rgba(40, 5, 70, 0.25), 0 1px 0 rgba(255, 255, 255, 0.2);
    font: 15px/1.55 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; scroll-margin-top: 24px;
  }
  .kit { display: grid; gap: 30px; padding: 0 28px 28px; }
  h3 { margin: 0 0 12px; font: 700 11px/1.4 'Montserrat', sans-serif; letter-spacing: 0.12em; text-transform: uppercase; color: #F1C40F; }
  .s { font-size: 13px; opacity: 0.75; }
  .facts { display: grid; grid-template-columns: 1fr; gap: 16px; }
  .facts > div { display: grid; gap: 2px; align-content: start; }
  .facts h3 { margin: 0 0 4px; }
  .facts b { font: 700 16px/1.3 'Montserrat', sans-serif; }
  .or { font: italic 400 13px/1.2 Georgia, 'Times New Roman', serif; opacity: 0.7; }
  .colours { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr; gap: 12px; }
  .colours li { font-size: 13px; }
  .sw { all: unset; box-sizing: border-box; cursor: pointer; width: 100%; display: flex; align-items: center; gap: 14px; padding: 6px; margin: -6px;
    border-radius: 18px; transition: background 0.15s; }
  .sw:hover, .chip:hover { background: rgba(255, 255, 255, 0.1); }
  .sw:focus-visible, .chip:focus-visible { outline: 2px solid #F1C40F; outline-offset: 2px; }
  .codes { list-style: none; margin: 18px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .chip { all: unset; box-sizing: border-box; cursor: pointer; width: 100%; display: flex; align-items: center; gap: 10px; padding: 6px 10px 6px 6px;
    border-radius: 14px; font: 600 13px 'Montserrat', sans-serif; transition: background 0.15s; }
  .chip i { flex: none; width: 28px; height: 28px; border-radius: 8px; box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.3); }
  .chip code { display: block; margin: 0; }
  /* With JavaScript the kit and the rows' codes are closed until opened; without it both show. */
  :global(.js) .press:not(.open), :global(.js) .codes:not(.open) { display: none; }
  @media (max-width: 719px) { .colours { gap: 16px; } }
  .colours i { flex: none; width: 38px; height: 38px; border-radius: 11px; box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.4); }
  .colours b { font: 700 14px 'Montserrat', sans-serif; }
  code { font: 500 12px 'Montserrat', sans-serif; opacity: 0.65; margin-left: 4px; }
  .dl { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .dl a { display: grid; gap: 8px; color: #fff; text-decoration: none; font: 600 13px 'Montserrat', sans-serif; text-align: center; border-radius: 14px; }
  .dl .th { position: relative; display: block; aspect-ratio: 3 / 2; border-radius: 14px;
    transition: transform 0.15s; }
  .dl .th img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; border-radius: 8px; }
  .dl .th.icon img { inset: 8%; width: auto; height: 84%; left: 50%; transform: translateX(-50%); aspect-ratio: 1; border-radius: 22%; }
  .dl a:hover .th { transform: translateY(-2px); }
  .dl a:focus-visible { outline: 2px solid #F1C40F; outline-offset: 3px; border-radius: 14px; }
  .col { display: grid; gap: 28px; align-content: start; }
  .col > h3 { margin-bottom: -16px; }
  /* wide: two equal columns (the words left, the colours right), then the images in one row, each titled under it */
  @media (min-width: 720px) {
    .kit { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 40px; }
    .imgs { grid-column: 1 / -1; }
    .colours { grid-template-columns: 1fr; gap: 10px; }
    .dl { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 16px; }
  }
  @media (max-width: 600px) { .dl { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (prefers-reduced-motion: reduce) { .pk-btn, .dl .th { transition: none; } }
</style>
