---
// The site footer, the same on every page: the pages as words, then contact, the iPhone and Android betas, @YoApp on X and GitHub as
// the header's symbols (other sites in a new tab), after Yo by Or Arbel, all in one line. It sits at the bottom of the window when the page is short.
import { operator } from '../data/legal';
const pages = [
  { href: '/', label: 'Yo' },
  { href: '/p/story', label: 'Story' },
  { href: '/p/changelog', label: 'New' },
  { href: '/#press', label: 'Press kit' },
  { href: '/p/privacy', label: 'Privacy' },
  { href: '/p/terms', label: 'Terms' },
  { href: '/p/imprint', label: 'Imprint' },
];
const icons = [
  { href: `mailto:${operator.email}`, label: 'Contact', view: '0 0 24 24', d: 'M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2.3V17h16V7.3l-8 5.2-8-5.2zM5.4 7l6.6 4.3L18.6 7H5.4z' },
  { href: 'https://testflight.apple.com/join/V3wa1DeX', label: 'iPhone beta on TestFlight', view: '0 0 24 24', d: 'M16.37 12.6c-.02-2.3 1.88-3.4 1.97-3.46-1.07-1.57-2.74-1.78-3.33-1.8-1.42-.14-2.77.83-3.49.83-.72 0-1.83-.81-3.01-.79-1.55.02-2.98.9-3.78 2.29-1.61 2.8-.41 6.94 1.16 9.21.77 1.11 1.68 2.36 2.88 2.31 1.16-.05 1.6-.75 3-.75s1.79.75 3.01.72c1.25-.02 2.04-1.13 2.8-2.24.88-1.29 1.24-2.53 1.26-2.6-.03-.01-2.42-.93-2.47-3.72zM14.07 5.85c.64-.77 1.07-1.85.95-2.92-.92.04-2.03.61-2.69 1.38-.59.68-1.11 1.77-.97 2.83 1.02.08 2.07-.52 2.71-1.29z' },
  { href: 'https://groups.google.com/g/yo-android-testers', label: 'Android beta on Google Play', view: '0 0 24 24', d: 'M4.6 2.3c-.3.3-.5.8-.5 1.4v16.6c0 .6.2 1.1.5 1.4l9.3-9.7zM15.1 13.2l2.9 3-11.2 6.3c-.5.3-1 .3-1.4.1zM15.1 10.8 5.4 1.4c.4-.2.9-.2 1.4.1l11.2 6.3zM19.1 8.5l2.4 1.4c.9.5.9 1.8 0 2.3l-2.4 1.4-3.2-3.3z' },
  { href: 'https://x.com/YoApp', label: '@YoApp on X', view: '0 0 24 24', d: 'M17.75 3h3.07l-6.71 7.67L22 21h-6.18l-4.84-6.33L5.44 21H2.37l7.18-8.2L2 3h6.34l4.37 5.78zm-1.08 16.18h1.7L7.4 4.73H5.58z' },
  { href: 'https://github.com/YoAgain/yo', label: 'Yo on GitHub', view: '0 0 16 16', d: 'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z' },
];
---
<footer class="site">
  <nav aria-label="Footer">
    <p class="by"><b>Yo</b> by Or Arbel</p>
    <ul class="pages">{pages.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    <ul class="icons">
      {icons.map((l) => (
        <li>
          <a href={l.href} aria-label={l.label} title={l.label} target={l.href.startsWith('http') ? '_blank' : undefined} rel={l.href.startsWith('http') ? 'noopener' : undefined}>
            <svg viewBox={l.view} width="18" height="18" aria-hidden="true"><path fill="currentColor" fill-rule="evenodd" d={l.d} /></svg>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</footer>
<style>
  .site { margin-top: auto; padding: 40px 16px 14px; font: 14px/1.4 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
  /* the pages as words, contact and the outside links as the header's symbols */
  nav { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 10px 22px; }
  ul { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; margin: 0; padding: 0; list-style: none; }
  a { display: grid; place-items: center; padding: 2px 8px; color: #fff; opacity: 0.7; text-decoration: none; }
  .icons a { width: 32px; height: 32px; padding: 0; }
  a:hover, a:focus-visible { opacity: 1; }
  a:focus-visible { outline: 2px solid #F1C40F; outline-offset: 3px; border-radius: 4px; }
  .by { margin: 0; font: 500 13px/1.4 'Montserrat', sans-serif; color: #fff; opacity: 0.6; }
  .by b { font-weight: 900; }
</style>
