---
// The <head> every page shares: charset, viewport, theme colour, title, description, canonical URL, icons, the web
// app manifest, the Open Graph and X (Twitter) share tags, and Montserrat, self-hosted from @fontsource/montserrat so
// no font request leaves the site. A page puts it first in
// its <head> and adds its own <style> (and anything else, such as JSON-LD) after it.
//
//   title        the window title, also the share title
//   description  the meta description, also the share description
//   path         the page's own path, e.g. "/p/story": the canonical URL and og:url are https://justyo.co + path; a
//                page without one (the 404 page, which answers at every unknown path) gets neither, nor share tags
//   image        the share image, a path or URL; imageAlt describes it. Default: /og/<path>.png with the alt
//                "Yo | <the title without Yo>", drawn at build time from that alt (og-images.mjs), 1200 x 630
//   share        share tags even without a path (the invite page, the 404 page at justyo.co/NAME): all but og:url
//   type         og:type: 'website' (default) or 'article'
//   noindex      tells search engines not to index the page
//   weights      the Montserrat weights the page declares (default 500;700;900); the browser only downloads a weight
//                (and only its latin or latin-ext part) when text on the page uses it
import m500 from '@fontsource/montserrat/files/montserrat-latin-500-normal.woff2?url';
import m500ext from '@fontsource/montserrat/files/montserrat-latin-ext-500-normal.woff2?url';
import m700 from '@fontsource/montserrat/files/montserrat-latin-700-normal.woff2?url';
import m700ext from '@fontsource/montserrat/files/montserrat-latin-ext-700-normal.woff2?url';
import m900 from '@fontsource/montserrat/files/montserrat-latin-900-normal.woff2?url';
import m900ext from '@fontsource/montserrat/files/montserrat-latin-ext-900-normal.woff2?url';
interface Props {
  title: string;
  description?: string;
  path?: string;
  image?: string;
  imageAlt?: string;
  share?: boolean;
  type?: 'website' | 'article';
  noindex?: boolean;
  weights?: string;
}
const {
  title,
  description,
  path,
  image: imageProp,
  imageAlt,
  share = false,
  type = 'website',
  noindex = false,
  weights = '500;700;900',
} = Astro.props;
const site = 'https://justyo.co';
const url = path === undefined ? undefined : new URL(path, site).href;
// The title without the site's name ("Yo – Story", "Something new – Yo"): the text of the drawn share image.
const text = title.replace(/^Yo – /, '').replace(/ – Yo$/, '');
const image = imageProp ?? `/og${path === '/' || path === undefined ? '/index' : path}.png`;
const shareImage = new URL(image, site).href;
// The site's own share images (in /og/, drawn at build time) are 1200 x 630.
const isOwnImage = image.startsWith('/og/');
const alt = imageAlt ?? (isOwnImage ? `Yo | ${text}` : undefined);
// The Montserrat files per weight, latin and latin-ext, with the unicode ranges Fontsource gives them.
const latin = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const latinExt = 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';
const files: Record<string, [string, string]> = { '500': [m500, m500ext], '700': [m700, m700ext], '900': [m900, m900ext] };
const face = (weight: string, src: string, range: string) =>
  `@font-face{font-family:'Montserrat';font-style:normal;font-display:swap;font-weight:${weight};src:url(${src}) format('woff2');unicode-range:${range}}`;
const fontCss = weights.split(';').filter((w) => w in files)
  .flatMap((w) => [face(w, files[w][1], latinExt), face(w, files[w][0], latin)]).join('');
---
<meta charset="utf-8" />
{/* Marks the page as running JavaScript before anything is drawn: content that JavaScript shows and hides is all
    visible without it (for crawlers and readers with JavaScript off), and hidden by the html.js styles with it. */}
<script is:inline>document.documentElement.classList.add('js');</script>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#9B59B6" />
{noindex && <meta name="robots" content="noindex" />}
<title>{title}</title>
{description && <meta name="description" content={description} />}
{url && <link rel="canonical" href={url} />}
<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
{(url || share) && (
  <>
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Yo" />
    {url && <meta property="og:url" content={url} />}
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={shareImage} />
    {isOwnImage && <meta property="og:image:width" content="1200" />}
    {isOwnImage && <meta property="og:image:height" content="630" />}
    {alt && <meta property="og:image:alt" content={alt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={shareImage} />
    {alt && <meta name="twitter:image:alt" content={alt} />}
  </>
)}
<Fragment set:html={`<style>${fontCss}</style>`} />
