---
// The site header: Yo, Story and New (the changelog; keys 1, 2, 3 switch between them), and at the top right the
// iPhone beta, Google Play (coming soon), @YoApp on X and the source on GitHub. Every Y and O in a menu item is set heavy.
interface Props { current?: string }
const { current } = Astro.props;
const items = [
  { href: '/', label: 'Yo' },
  { href: '/p/story', label: 'Story' },
  { href: '/p/changelog', label: 'New' },
];
const parts = (label: string) => label.split(/([yo])/i).filter(Boolean);
---
<header class="site">
  <nav aria-label="Main">
    {items.map(({ href, label }) => (
      <a href={href} aria-label={label} aria-current={current === href ? 'page' : undefined}>
        <span aria-hidden="true">{parts(label).map((p) => (/^[yo]$/i.test(p) ? <b>{p}</b> : p))}</span>
      </a>
    ))}
  </nav>
  <div class="ends">
    <a class="ic store" href="https://testflight.apple.com/join/V3wa1DeX" target="_blank" rel="noopener" aria-label="Get the iPhone beta on TestFlight" title="iPhone beta (TestFlight)">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M16.37 12.6c-.02-2.3 1.88-3.4 1.97-3.46-1.07-1.57-2.74-1.78-3.33-1.8-1.42-.14-2.77.83-3.49.83-.72 0-1.83-.81-3.01-.79-1.55.02-2.98.9-3.78 2.29-1.61 2.8-.41 6.94 1.16 9.21.77 1.11 1.68 2.36 2.88 2.31 1.16-.05 1.6-.75 3-.75s1.79.75 3.01.72c1.25-.02 2.04-1.13 2.8-2.24.88-1.29 1.24-2.53 1.26-2.6-.03-.01-2.42-.93-2.47-3.72zM14.07 5.85c.64-.77 1.07-1.85.95-2.92-.92.04-2.03.61-2.69 1.38-.59.68-1.11 1.77-.97 2.83 1.02.08 2.07-.52 2.71-1.29z"/></svg>
    </a>
    <span class="ic store soon" role="img" aria-label="Google Play: coming soon" title="Google Play: coming soon">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M4.6 2.3c-.3.3-.5.8-.5 1.4v16.6c0 .6.2 1.1.5 1.4l9.3-9.7zM15.1 13.2l2.9 3-11.2 6.3c-.5.3-1 .3-1.4.1zM15.1 10.8 5.4 1.4c.4-.2.9-.2 1.4.1l11.2 6.3zM19.1 8.5l2.4 1.4c.9.5.9 1.8 0 2.3l-2.4 1.4-3.2-3.3z"/></svg>
    </span>
    <a class="ic" href="https://x.com/YoApp" target="_blank" rel="noopener" aria-label="Yo on X" title="@YoApp on X">
      <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><path fill="currentColor" d="M17.75 3h3.07l-6.71 7.67L22 21h-6.18l-4.84-6.33L5.44 21H2.37l7.18-8.2L2 3h6.34l4.37 5.78zm-1.08 16.18h1.7L7.4 4.73H5.58z"/></svg>
    </a>
    <a class="ic" href="https://github.com/YoAgain/yo" target="_blank" rel="noopener" aria-label="Yo on GitHub">
      <svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
    </a>
  </div>
</header>
<script is:inline define:vars={{ paths: items.map((i) => i.href) }}>
  // Keys 1, 2, 3 switch between the menu items (not while typing, not with a modifier, not while a dialog is open).
  addEventListener('keydown', (e) => {
    if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.altKey || e.isComposing) return;
    if (document.querySelector('dialog[open]')) return;
    const t = e.target;
    if (t instanceof HTMLElement && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) return;
    const to = paths[Number(e.key) - 1];
    if (to && to !== location.pathname) location.href = to;
  });
</script>
<style>
  /* the menu as one pill like the Yo admin hub (38px high, the active tab filled); the links on the right stand alone */
  .site {
    position: absolute; top: 0; left: 0; right: 0; z-index: 1;
    padding: max(0.9rem, env(safe-area-inset-top)) 1rem 0;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
  }
  nav {
    display: flex; align-items: stretch; gap: 2px; height: 38px; box-sizing: border-box; padding: 3px; border-radius: 999px;
    background: rgba(50, 10, 80, 0.22); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  }
  nav { grid-column: 2; font: 600 0.92rem/1 'Montserrat', sans-serif; }
  .ends { grid-column: 3; justify-self: end; display: flex; gap: 4px; }
  a, .ic { color: #fff; text-decoration: none; border-radius: 999px; transition: background 0.15s, color 0.15s; }
  nav a { display: flex; align-items: center; padding: 0 16px; }
  .ic { display: grid; place-items: center; width: 36px; height: 36px; }
  .ic svg { width: 18px; height: 18px; }
  .soon { opacity: 0.45; cursor: default; }
  @media (max-width: 560px) { .store { display: none; } }
  a:hover { background: rgba(255, 255, 255, 0.14); }
  a:focus-visible { outline: 2px solid #F1C40F; outline-offset: 2px; }
  nav a[aria-current='page'] { background: #fff; color: #8E44AD; }
  b { font-weight: 900; }
</style>
