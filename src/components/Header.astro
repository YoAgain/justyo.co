---
// The site header: Yo and Security, the source on GitHub at the top right. Every Y and O in a menu item is set heavy.
interface Props { current?: string }
const { current } = Astro.props;
const items = [
  { href: '/', label: 'Yo' },
  { href: '/p/security', label: 'Security' },
];
const parts = (label: string) => label.split(/([yo])/i).filter(Boolean);
---
<header class="site">
  <nav aria-label="Main">
    {items.map(({ href, label }) => (
      <a href={href} aria-label={label} aria-current={current === href ? 'page' : undefined}>
        <span aria-hidden="true">{parts(label).map((p) => (/^[yo]$/i.test(p) ? <b>{p}</b> : p))}</span>
      </a>
    ))}
  </nav>
  <a class="gh" href="https://github.com/YoAgain/yo" aria-label="Yo on GitHub">
    <svg viewBox="0 0 16 16" width="24" height="24" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
  </a>
</header>
<style>
  .site {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1;
    padding: max(0.9rem, env(safe-area-inset-top)) 1rem 0;
  }
  nav {
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    font: 500 1rem/1 'Montserrat', sans-serif;
  }
  a {
    color: #fff;
    text-decoration: none;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    transition: background 0.15s;
  }
  .gh { position: absolute; top: max(0.9rem, env(safe-area-inset-top)); right: 1rem; padding: 0.4rem; display: grid; }
  a:hover, a:focus-visible { background: rgba(255, 255, 255, 0.15); }
  a:focus-visible { outline: 2px solid #F1C40F; outline-offset: 2px; }
  a[aria-current='page'] { background: rgba(0, 0, 0, 0.14); }
  b { font-weight: 900; }
</style>
