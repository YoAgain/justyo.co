---
// An outlet's name set as a wordmark in plain type (serif, heavy sans, condensed, boxed), white, no logo files.
import type { Mark } from '../lib/outlets';
interface Props { name: string; mark: Mark; size?: number; dark?: boolean }
const { name, mark, size = 22, dark = false } = Astro.props;
---
<span class={`wm ${mark}${dark ? ' dark' : ''}`} style={`--s:${size}px`}>{mark === 'box' ? [...name].map((c) => <i>{c}</i>) : name}</span>
<style>
  .wm { display: inline-flex; align-items: center; gap: 2px; white-space: nowrap; color: #fff; font-size: var(--s); line-height: 1; }
  .serif { font-family: Georgia, 'Times New Roman', serif; font-weight: 700; letter-spacing: -0.01em; }
  .serif-italic { font-family: Georgia, 'Times New Roman', serif; font-style: italic; font-weight: 700; }
  .sans { font-family: 'Helvetica Neue', Arial, sans-serif; font-weight: 600; letter-spacing: -0.02em; }
  .sans-heavy { font-family: 'Montserrat', 'Helvetica Neue', Arial, sans-serif; font-weight: 900; letter-spacing: -0.03em; }
  .condensed { font-family: 'Arial Narrow', 'Helvetica Neue', Arial, sans-serif; font-stretch: condensed; font-weight: 800; text-transform: uppercase; letter-spacing: 0.02em; }
  .dark { color: #1b1022; }
  .box { gap: 3px; }
  .box i { font: normal 800 calc(var(--s) * 0.8) / 1 'Helvetica Neue', Arial, sans-serif; display: grid; place-items: center;
    width: calc(var(--s) * 1.1); height: calc(var(--s) * 1.1); background: #fff; color: #8E44AD; }
  .dark.box i { background: #1b1022; color: #fff; }
</style>
