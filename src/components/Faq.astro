---
// The FAQ at the foot of the home page: the questions as pills that stay put; hovering, focusing or clicking one shows
// its one-line answer in big plain words under them. The press kit is its own widget (PressKit.astro).
const qa: [string, string][] = [["What is Yo?", "The simplest app in the world."], ["Who makes Yo?", "Or Arbel made it. <a href=\"https://github.com/YoAgain\" target=\"_blank\" rel=\"noopener\">YoAgain</a> runs it, with his blessing."], ["Is it free?", "Yes. No ads, no tracking."], ["Android?", "On its way!"], ["Can anyone read my Yos?", "No. <a href=\"#security\" data-tech>Yo-to-Yo encrypted.</a>"], ["Photos?", "Tap the camera, then a name."], ["Groups?", "Tap +, then Group."]];
---
<section class="faq" id="faq" aria-labelledby="faq-title">
  <h2 id="faq-title">Questions</h2>
  <div class="pills" role="tablist" aria-label="Questions">
    {qa.map(([q], i) => (
      <button type="button" role="tab" id={`q${i}`} aria-controls="faq-answer" aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}>{q}</button>
    ))}
  </div>
  {/* Every answer is in the page; without JavaScript all of them show, with it only the chosen one (html.js). */}
  <div class="answer" id="faq-answer" role="tabpanel" aria-labelledby="q0" aria-live="polite">
    {qa.map(([, a], i) => <p data-i={i} class:list={{ shown: i === 0 }} set:html={a} />)}
  </div>
</section>
<script>
  // "Yo-to-Yo encrypted." opens the technical details pop-up (Security sits just above, so a jump there shows little);
  // without JavaScript it is a plain link to the Security section.
  document.querySelectorAll<HTMLAnchorElement>('.faq a[data-tech]').forEach((a) =>
    a.addEventListener('click', (e) => {
      const d = document.getElementById('tech-details') as HTMLDialogElement | null;
      if (!d) return;
      e.preventDefault();
      d.showModal();
    }),
  );

  // A question pill hovered (with a mouse), focused or clicked shows its answer in the one place under the pills.
  // The pills are tabs: only the chosen one is in the Tab order, and the arrow keys, Home and End move between them.
  document.querySelectorAll<HTMLElement>('.faq').forEach((faq) => {
    const pills = [...faq.querySelectorAll<HTMLButtonElement>('.pills button')];
    const answers = [...faq.querySelectorAll<HTMLElement>('.answer p')];
    const panel = faq.querySelector<HTMLElement>('.answer')!;
    const show = (i: number) => {
      pills.forEach((p, j) => {
        p.setAttribute('aria-selected', String(j === i));
        p.tabIndex = j === i ? 0 : -1;
      });
      answers.forEach((a, j) => a.classList.toggle('shown', j === i));
      panel.setAttribute('aria-labelledby', pills[i].id);
    };
    pills.forEach((p, i) => {
      p.addEventListener('click', () => show(i));
      p.addEventListener('focus', () => show(i));
      p.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') show(i); });
      p.addEventListener('keydown', (e) => {
        const n = pills.length;
        const to = ({ ArrowRight: i + 1, ArrowDown: i + 1, ArrowLeft: i - 1, ArrowUp: i - 1, Home: 0, End: n - 1 } as Record<string, number>)[e.key];
        if (to === undefined) return;
        e.preventDefault();
        // Focusing the pill also selects it (see the focus listener above).
        pills[(to + n) % n].focus();
      });
    });
  });
</script>
<style>
  .faq { max-width: 1000px; box-sizing: border-box; margin: 0 auto; padding: 72px 20px 24px; color: #fff; text-align: center; }
  h2 { margin: 0 0 28px; font: 900 clamp(2rem, 6.5vw, 3.2rem)/1.05 'Montserrat', sans-serif; letter-spacing: -0.01em;
    text-shadow: 0 4px 0 rgba(60, 10, 90, 0.2); }
  /* the questions as pills that never move; the chosen one's answer in one place under them */
  .pills { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; max-width: 820px; margin: 0 auto; }
  button { all: unset; cursor: pointer; padding: 10px 20px; border-radius: 999px; font: 700 1rem/1.2 'Montserrat', sans-serif;
    background: rgba(255, 255, 255, 0.14); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22); transition: background 0.15s, color 0.15s; }
  button:hover { background: rgba(255, 255, 255, 0.22); }
  button[aria-selected='true'] { color: #8E44AD; background: linear-gradient(180deg, #FFE36E, #F1C40F); box-shadow: 0 6px 14px -6px rgba(40, 5, 70, 0.6); }
  button:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  /* the answer: big plain words under the pills, in a fixed height so nothing below moves */
  .answer { max-width: 640px; min-height: 4.4em; margin: 26px auto 0; display: grid; place-items: center; }
  /* With JavaScript only the chosen answer shows; without it every answer does, one under the other. */
  :global(.js) .answer p:not(.shown) { display: none; }
  .answer p { margin: 0; font: 700 clamp(1.25rem, 3.2vw, 1.6rem)/1.3 'Montserrat', sans-serif; letter-spacing: -0.005em;
    text-shadow: 0 3px 0 rgba(60, 10, 90, 0.18); animation: in 0.25s ease-out; }
  @keyframes in { from { opacity: 0; transform: translateY(6px); } }
  .answer :global(a) { color: #F1C40F; text-decoration: none; }
  .answer :global(a:hover) { text-decoration: underline; text-underline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) { button { transition: none; } .answer p { animation: none; } }
</style>
