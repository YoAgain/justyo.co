---
// justyo.co/services/NAME: a service; with ?state=…: connect it. What there is comes from
// api.justyo.app (the whole list, so it never learns which one is looked at), and only what is there is shown.
//
// Connecting is OAuth 2 (RFC 6749): the other side sends its user here with its `state`, which is the code too. The app,
// opened by the button or the QR code, tells its hash to the service's account once the user allowed it; Continue takes
// it back to the other side, to the address of the list, never one of the link. No server behind this page.
---
<main id="services" hidden>
  <div class="logos" id="logos" hidden></div>
  <h1 id="title"></h1>
  <p id="about"></p>
  <div class="card" id="serviceCard" role="img" aria-label="QR code to open Yo" hidden><svg id="serviceCode" viewBox="0 0 260 260"></svg></div>
  <a class="act" id="serviceOpen" href="#" hidden>Open in Yo</a>
  <a class="act second" id="serviceContinue" href="#" hidden>Allowed? Continue</a>
</main>
<style is:global>
  #services { box-sizing: border-box; min-height: 100vh; min-height: 100svh; padding: 24px 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 22px; text-align: center; }
  #services [hidden], #services[hidden] { display: none; }
  #services h1 { margin: 0 16px; font-size: clamp(2rem, 7vw, 3.2rem); font-weight: 900; line-height: 1.1; }
  #services p { margin: 0 16px; max-width: 26rem; line-height: 1.4; }
  #services .card { padding: 18px; background: #fff; }
  #services .card svg { display: block; height: auto; width: min(60vw, 34svh, 280px); }
  .logos { display: flex; align-items: center; gap: 14px; font-size: 26px; font-weight: 900; }
  .logos i { display: flex; width: 76px; height: 76px; border-radius: 18px; align-items: center; justify-content: center; background: rgba(0, 0, 0, .22); font-style: normal; }
  .logos img { width: 76px; height: 76px; border-radius: 18px; }
  .act { box-sizing: border-box; width: min(100% - 32px, 316px); padding: 18px; color: #fff; text-decoration: none; background: #2ECC71; font-size: 20px; }
  .act.second { background: rgba(0, 0, 0, .22); }
</style>
<script>
  import qrcode from 'qrcode-generator';

  type Service = { name: string; about: string; bridge: { return_url: string } | null; logo: string | null };
  const API = 'https://api.justyo.app';
  const $ = (id: string) => document.getElementById(id)!;
  const [, root, wanted, more] = location.pathname.replace(/\/+$/, '').split('/');

  const image = (service: Service) => {
    const logo = document.createElement('img');
    logo.alt = '';
    logo.src = API + service.logo;
    return logo;
  };

  function say(title: string, about: string) {
    $('title').textContent = title;
    $('about').textContent = about;
    document.title = `${title} | Yo`;
  }

  async function show(service: Service) {
    const state = new URLSearchParams(location.search).get('state');
    const back = service.bridge?.return_url ?? '';
    const asked = new URLSearchParams(location.search);
    const connect = !!state && state.length >= 16 && /^https:\/\/[a-z0-9.-]+\/[A-Za-z0-9._\/-]+$/.test(back)
      && asked.get('response_type') === 'code' && (asked.get('redirect_uri') ?? back) === back;
    if (state && !connect) return say('Nothing to connect.', `Start at ${service.name}.`);
    if (service.logo) {
      const yo = document.createElement('i');
      yo.textContent = 'Yo';
      $('logos').replaceChildren(yo, '+', image(service));
      $('logos').hidden = false;
    }
    const phone = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent)
      || (/Macintosh/.test(navigator.userAgent) && navigator.maxTouchPoints > 1);
    let link = 'yo://' + encodeURIComponent(service.name), scan = 'https://justyo.co/' + encodeURIComponent(service.name);
    if (connect) {
      // What the app tells the service's account is the hash of the other side's value; the value itself goes back.
      const hash = new Uint8Array(await crypto.subtle.digest('SHA-256', new TextEncoder().encode(state)));
      const code = btoa(String.fromCharCode(...hash)).replaceAll('+', '-').replaceAll('/', '_').replaceAll('=', '');
      link = scan = `yo://services/${wanted.toLowerCase()}/connect?code=${code}`;
      ($('serviceContinue') as HTMLAnchorElement).href = `${back}?${new URLSearchParams({ code: state, state })}`;
      $('serviceContinue').hidden = false;
      say(`Connect ${service.name}`, phone ? 'Open Yo and allow it, then come back here.' : 'Scan the code with your phone and allow it in Yo.');
    } else say(service.name, service.about);
    ($('serviceOpen') as HTMLAnchorElement).href = link;
    $('serviceOpen').hidden = !phone;
    $('serviceCard').hidden = phone;
    if (phone) return;
    const qr = qrcode(0, 'M');
    qr.addData(scan);
    qr.make();
    const c = qr.getModuleCount(), m = 260 / c;
    let out = '';
    for (let r = 0; r < c; r++) for (let k = 0; k < c; k++) {
      if (qr.isDark(r, k)) out += `<rect x="${k * m}" y="${r * m}" width="${m}" height="${m}"/>`;
    }
    $('serviceCode').innerHTML = `<g fill="#9B59B6" shape-rendering="crispEdges">${out}</g>`;
  }

  if (root === 'services' && wanted && !more) {
    $('invite').hidden = $('lost').hidden = true;
    $('services').hidden = false;
    try {
      const answer = await fetch(`${API}/services`, { referrerPolicy: 'no-referrer', credentials: 'omit' });
      if (!answer.ok) throw new Error();
      const services: Service[] = await answer.json();
      const service = services.find((s) => s.name.toLowerCase() === wanted?.toLowerCase());
      if (service) await show(service);
      else say('Nothing here.', '');
    } catch {
      say('Try again later.', '');
    }
  }
</script>
