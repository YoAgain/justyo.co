  /* Camera mode, the app's camera "context": the live picture behind the bars, the bars see-through (45%), "+" gone;
     at the bottom the library, the zoom, the switch and "✕"; what to do in a glass capsule over them */
  /* The camera's picture: back or front (mirrored, as the app shows the selfie camera), zoomed by the 1× button; a
     photo picked from the library stands in for it */
  .yo-phone .cambg { position: absolute; inset: 0; z-index: 0; overflow: hidden; opacity: 0; transition: opacity 0.35s ease; }
  .yo-phone .lens { position: absolute; inset: 0; transform: scale(var(--zoom, 1.3)); transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1); }
  .yo-phone .live, .yo-phone .picked { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity 0.25s ease; }
  .yo-phone .live.front { opacity: 0; transform: scaleX(-1); } /* selfie.webp is stored mirrored, so the plush Yo reads the right way round */
  .yo-phone.front .live.front { opacity: 1; }
  .yo-phone.front .live.back { opacity: 0; }
  .yo-phone .picked { opacity: 0; }
  .yo-phone.has-picked .picked { opacity: 1; }
  .yo-phone .zoom { cursor: pointer; }
