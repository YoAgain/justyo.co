  .yo-phone .bars li { background: var(--c); transition: background-color 0.3s ease; }
  .yo-phone[data-interactive] .bars li { cursor: pointer; }
  .yo-phone .bars li.ghost { position: absolute; left: 0; right: 0; z-index: 0; pointer-events: none; }
  /* Sent: the words in the middle, their "!"s and " +n" hanging after them, so nothing shifts as they come */
  .yo-phone .words { position: relative; }
  .yo-phone .words.fresh { animation: yp-words 0.2s ease-out; }
  .yo-phone .tail { position: absolute; left: 100%; top: 0; display: flex; white-space: pre; }
  .yo-phone .tail b, .yo-phone .end b { font-weight: inherit; display: inline-block; animation: yp-bang 0.16s ease-out; }
  .yo-phone .plus { font-variant-numeric: tabular-nums; white-space: pre; }
  /* Received: the name stays, "Yo" and its "!"s at the bar's end; it knocks as a run starts, fades as it ends */
  .yo-phone .end {
    position: absolute;
    right: calc(var(--pw) * 0.06);
    top: 50%;
