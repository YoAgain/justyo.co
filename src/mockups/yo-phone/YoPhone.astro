    transition: opacity 2s ease;
  }
  .yo-phone .end:empty { display: none; }
  .yo-phone .end.knock { animation: yp-knock 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.4); }
  .yo-phone .end.fading { opacity: 0; }
  /* "+" open: a name field for a moment */
  .yo-phone .add .text { font-size: calc(var(--pw) * 0.1); }
