  /* The library: the app's photo picker, a grid of square pictures */
  .yo-phone .grid { list-style: none; margin: 0 calc(var(--pw) * -0.045); padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }
  .yo-phone .grid li { position: relative; aspect-ratio: 1; background: #2C2C2E center / cover no-repeat; cursor: pointer; }
  .yo-phone .grid button { all: unset; position: absolute; inset: 0; cursor: pointer; }
  .yo-phone .grid li:hover { filter: brightness(1.1); }
  .yo-phone .bars { z-index: 1; }
