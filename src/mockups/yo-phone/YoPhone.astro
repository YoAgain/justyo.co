  .yo-phone.camera .cam .i-x, .yo-phone.camera .lib, .yo-phone.camera .flip, .yo-phone.camera .zoom, .yo-phone.camera .camhint { opacity: 1; transform: none; }
  .yo-phone.camera .lib, .yo-phone.camera .flip, .yo-phone.camera .zoom { pointer-events: auto; }
  .yo-phone.camera.front .zoom, .yo-phone.camera.has-picked .zoom { pointer-events: none; }
  .yo-phone .lib { left: calc(var(--pw) * 0.045); }
