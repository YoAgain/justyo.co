  .yo-phone.camera .lib, .yo-phone.camera .flip { cursor: pointer; }
  .yo-phone .lib .thumb { display: none; position: absolute; inset: 0; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
  .yo-phone.has-picked .lib .thumb { display: block; }
