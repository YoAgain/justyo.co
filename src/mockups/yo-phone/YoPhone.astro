  @keyframes yp-blink { 50% { opacity: 0; } }

  /* The phone's controls are buttons drawn exactly as before: nothing of a button's own look is kept. */
  .yo-phone .fab, .yo-phone .zoom { all: unset; }
  /* The keyboard's focus: a white ring on the control, inside the edge where the screen would cut it off. */
  .yo-phone .screen button:focus-visible, .yo-phone .screen .head[tabindex]:focus-visible { outline: 2px solid #fff; outline-offset: -3px; }
  .yo-phone .screen .fab:focus-visible, .yo-phone .screen .zoom:focus-visible { outline-offset: 2px; }
  .yo-phone .fab { /* "•••" and the camera, in glass, at the bottom corners */
